// OBJECTS & GLOBAL VARIABLES
// ============================================================
Adafruit_SSD1306 oled(OLED_WIDTH, OLED_HEIGHT, &Wire, -1);
LedControl lc = LedControl(PIN_DIN, PIN_CLK, PIN_CS, NUM_MODULES);

Lang currentLang = LANG_SW;
State currentState = STATE_BOOT;

int selectedGame = 0;
int langCursor = 0;
int gameCursor = 0;

int gameScore = 0;
int gameLevel = 1;
int gameLives = 3;
bool gameFinished = false;

bool oledReady = false;
unsigned long lastOledRefresh = 0;
bool oledDirty = true;

int highScores[GAME_COUNT] = {0};

// Module Configurations (Re-orient orientation if matrix is upside down)
struct ModuleConfig {
  bool mirrorX;
  bool mirrorY;
  bool swapXY;
};

ModuleConfig modCfg[NUM_MODULES] = {
  {false, false, false},  // Module 1 — Juu-Kushoto
  {false, false, false},  // Module 2 — Juu-Kulia
  {false, false, false},  // Module 3 — Chini-Kushoto
  {false, false, false}   // Module 4 — Chini-Kulia
