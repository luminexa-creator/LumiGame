/* ============================================================
   LUMIGAME v2.4 — COMPLETE SYSTEM CODE
   Hardware: Arduino UNO + 4x MAX7219 Matrix (2x2 Grid) + OLED SSD1306
   Pins: DIN=12, CLK=11, CS=10, OLED(A4/A5), Joy(A0/A1/D5), BTNS(D2/D3/D4)
   ============================================================ */

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <LedControl.h>
#include <EEPROM.h>

// ============================================================
// CONFIG & PINS
// ============================================================
#define PIN_DIN   12
#define PIN_CLK   11
#define PIN_CS    10
#define NUM_MODULES 4

#define OLED_WIDTH  128
#define OLED_HEIGHT 64
#define OLED_ADDR_A 0x3C
#define OLED_ADDR_B 0x3D
#define OLED_REFRESH_MS 100   

#define BTN_OK     2
#define BTN_LEFT   3
#define BTN_RIGHT  4
#define JOY_SW     5

#define JOY_X      A0
#define JOY_Y      A1

#define DISP_W  16
#define DISP_H  16

enum State { STATE_BOOT, STATE_LANGUAGE, STATE_MENU, STATE_PLAYING, STATE_GAME_OVER };
enum GameID { GAME_PONG, GAME_SNAKE, GAME_BREAKOUT, GAME_INVADERS, GAME_FLAPPY, GAME_COUNT };
enum Lang { LANG_SW = 0, LANG_EN = 1 };

