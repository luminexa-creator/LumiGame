// ============================================================
// BUTTONS & JOYSTICK
// ============================================================
struct Button { uint8_t pin; bool lastState; unsigned long lastPress; };
Button btnOK    = {BTN_OK,    HIGH, 0};
Button btnLeft  = {BTN_LEFT,  HIGH, 0};
Button btnRight = {BTN_RIGHT, HIGH, 0};

bool buttonPressed(Button &b) {
  bool reading = digitalRead(b.pin);
  unsigned long now = millis();
  if (reading == LOW && b.lastState == HIGH && (now - b.lastPress) > 180) {
    b.lastState = reading;
    b.lastPress = now;
    return true;
  }
  if (reading == HIGH) b.lastState = HIGH;
  return false;
}

bool joystickPressed() {
  static bool lastState = HIGH;
  static unsigned long lastPress = 0;
  bool reading = digitalRead(JOY_SW);
  unsigned long now = millis();
  if (reading == LOW && lastState == HIGH && (now - lastPress) > 180) {
    lastState = reading; lastPress = now;
    return true;
  }
  if (reading == HIGH) lastState = HIGH;
  return false;
}

int readJoystickX() {
  long sum = 0;
  for (int i = 0; i < 4; i++) { sum += analogRead(JOY_X); }
  return sum / 4;
}

int readJoystickY() {
  long sum = 0;
  for (int i = 0; i < 4; i++) { sum += analogRead(JOY_Y); }
  return sum / 4;
}

// ============================================================
// MATRIX MAPPING
// ============================================================
void setPixel(int x, int y, bool on = true) {
  if (x < 0 || x >= DISP_W || y < 0 || y >= DISP_H) return;

  int module, localX, localY;

  if (y < 8) {
    module = (x < 8) ? 0 : 1;
    localY = y;
  } else {
    module = (x < 8) ? 2 : 3;
    localY = y - 8;
  }
  localX = (x < 8) ? x : x - 8;

  ModuleConfig &cfg = modCfg[module];

  if (cfg.swapXY) {
    int tmp = localX; localX = localY; localY = tmp;
  }
  if (cfg.mirrorX) localX = 7 - localX;
  if (cfg.mirrorY) localY = 7 - localY;

  lc.setLed(module, localY, localX, on);
}

void clearMatrix() { 
  for (int i = 0; i < NUM_MODULES; i++) lc.clearDisplay(i); 
}

// ============================================================
// BOOT SCREEN: "LUMIGAME" (3 SECONDS)
// ============================================================
const uint8_t font5x3_L[] PROGMEM = {0x1F, 0x10, 0x10};
const uint8_t font5x3_U[] PROGMEM = {0x1F, 0x01, 0x1F};
const uint8_t font5x3_M[] PROGMEM = {0x1F, 0x08, 0x1F};
const uint8_t font5x3_I[] PROGMEM = {0x1F, 0x00, 0x00};

void drawChar3x5(int x, int y, const uint8_t* font) {
  for (int col = 0; col < 3; col++) {
    uint8_t line = pgm_read_byte(font + col);
    for (int row = 0; row < 5; row++) {
      if (line & (1 << row)) setPixel(x + col, y + row);
    }
  }
}

void showBootAnimation() {
  if (oledReady) {
    oled.clearDisplay();
    oled.setTextSize(2);
    oled.setTextColor(SSD1306_WHITE);
    oled.setCursor(16, 20);
    oled.println(F("LUMIGAME"));
    oled.setTextSize(1);
    oled.setCursor(28, 45);
    oled.println(F("SYSTEM READY"));
    oled.display();
  }

  unsigned long start = millis();
  while (millis() - start < 3000) {
    clearMatrix();
    drawChar3x5(0,  1, font5x3_L);
    drawChar3x5(4,  1, font5x3_U);
    drawChar3x5(8,  1, font5x3_M);
    drawChar3x5(12, 1, font5x3_I);

    int t = (millis() / 150) % 16;
    for (int i = 0; i < DISP_W; i++) {
      if ((i + t) % 4 == 0) {
        setPixel(i, 8);
        setPixel(15 - i, 15);
      }
    }
    delay(50);
  }
  clearMatrix();
}

// ============================================================
// HARDWARE INIT
// ============================================================
void hardwareInit() {
  Wire.begin();

  if (oled.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR_A)) {
    oledReady = true;
  } else if (oled.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR_B)) {
    oledReady = true;
  }

  for (int i = 0; i < NUM_MODULES; i++) {
    lc.shutdown(i, false);
    lc.setIntensity(i, 4);
    lc.clearDisplay(i);
  }

  pinMode(BTN_OK, INPUT_PULLUP);
  pinMode(BTN_LEFT, INPUT_PULLUP);
  pinMode(BTN_RIGHT, INPUT_PULLUP);
  pinMode(JOY_SW, INPUT_PULLUP);

  showBootAnimation();
}

// ============================================================
// OLED UI
// ============================================================
void markOledDirty() { oledDirty = true; }

bool shouldRefreshOled() {
  unsigned long now = millis();
  if (oledDirty || (now - lastOledRefresh) > OLED_REFRESH_MS) {
    lastOledRefresh = now;
    oledDirty = false;
    return true;
  }
  return false;
}

void drawLanguageScreen() {
  if (!oledReady || !shouldRefreshOled()) return;
  oled.clearDisplay();
  oled.setTextSize(1);
  oled.setCursor(0, 0);
  oled.println(T().selectLang);
  oled.drawLine(0, 10, 128, 10, SSD1306_WHITE);
  oled.setCursor(10, 24);
  oled.print(langCursor == 0 ? "> " : "  ");
  oled.println(T().kiswahili);
  oled.setCursor(10, 42);
  oled.print(langCursor == 1 ? "> " : "  ");
  oled.println(T().english);
  oled.display();
}

void drawMenuScreen() {
  if (!oledReady || !shouldRefreshOled()) return;
  oled.clearDisplay();
  oled.setTextSize(1);
  oled.setCursor(0, 0);
  oled.println(T().selectGame);
  oled.drawLine(0, 10, 128, 10, SSD1306_WHITE);
  for (int i = 0; i < GAME_COUNT; i++) {
    oled.setCursor(10, 18 + i * 9);
    oled.print(i == gameCursor ? "> " : "  ");
    oled.print(i + 1); oled.print(". ");
    oled.println(T().gameNames[i]);
  }
  oled.display();
}

void drawHUD() {
  if (!oledReady || !shouldRefreshOled()) return;
  oled.clearDisplay();
  oled.setTextSize(1);
  oled.setCursor(0, 0);
  oled.println(T().gameNames[gameCursor]);
  oled.drawLine(0, 10, 128, 10, SSD1306_WHITE);
  oled.setCursor(0, 20);
  oled.print(T().score); oled.print(": "); oled.println(gameScore);
  oled.setCursor(0, 34);
  oled.print(T().level); oled.print(": "); oled.println(gameLevel);
  oled.setCursor(0, 48);
  oled.print(T().lives); oled.print(": "); oled.println(gameLives);
  oled.display();
}

void drawGameOver(int highScore) {
  if (!oledReady || !shouldRefreshOled()) return;
  oled.clearDisplay();
  oled.setTextSize(1);
  oled.setCursor(20, 5);
  oled.println(T().gameOver);
  oled.drawLine(0, 15, 128, 15, SSD1306_WHITE);
  oled.setCursor(10, 25);
  oled.print(T().score); oled.print(": "); oled.println(gameScore);
  oled.setCursor(10, 40);
  oled.print(T().highScore); oled.print(": "); oled.println(highScore);
  oled.setCursor(20, 55);
  oled.println(T().pressOK);
  oled.display();
}

